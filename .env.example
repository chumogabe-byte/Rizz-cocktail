# Copy to your host's environment settings (never commit real keys).
PORT=3001
STAFF_PIN=change-me
DATA_FILE=/data/db.json

# ---- M-Pesa (Safaricom Daraja, M-Pesa Express / STK Push) ----
# mock = test mode (no real money), sandbox = Daraja test credentials, production = live Paybill/Till
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Rizz Buy Goods till that receives payments
MPESA_TILL=1750964
# Store / Head-Office number Safaricom linked to the till for Lipa na M-Pesa Online (defaults to the till).
# In sandbox leave blank (uses Daraja's test shortcode 174379).
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Public HTTPS address of this server — Safaricom sends payment confirmations to <this>/api/mpesa/callback/...
MPESA_CALLBACK_URL=https://rizz.example.com
