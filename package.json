{
  "name": "rizz-cocktail-bar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "build": "npm run seed:offline && tsc && vite build",
    "start": "npm run build && node server/index.js",
    "preview": "vite preview",
    "build:admin": "npm run seed:offline && tsc && VITE_APP=admin vite build --outDir dist-admin",
    "seed:offline": "node scripts/make-offline-seed.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
